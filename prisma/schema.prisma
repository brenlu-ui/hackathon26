generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Appliance {
  washing_machine
  dishwasher
  shower
  toilet
  kitchen_faucet
  garden_hose
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplianceDefault {
  id            String    @id @default(cuid())
  appliance     Appliance @unique
  litersPerUnit Decimal   @db.Decimal(8, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WaterLog {
  id             String    @id @default(cuid())
  appliance      Appliance
  quantity       Decimal   @db.Decimal(8, 2)
  litersPerUnit  Decimal   @db.Decimal(8, 2)
  estimatedLiters Decimal  @db.Decimal(10, 2)
  occurredAt     DateTime
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([occurredAt])
  @@index([appliance])
}
